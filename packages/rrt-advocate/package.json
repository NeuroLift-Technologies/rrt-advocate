{
  "name": "@neurolift-technologies/rrt-advocate",
  "version": "0.1.0",
  "description": "Crisis Detection Engine (CDE) — TypeScript port of the RRT Advocate 3-layer, local-first crisis detection & assessment pipeline. NeuroLift HAIEF Solidarity Framework.",
  "keywords": [
    "ai",
    "crisis-detection",
    "mental-health",
    "neurodivergent",
    "adhd",
    "trauma-informed",
    "solidarity-framework",
    "haief",
    "local-first"
  ],
  "license": "Apache-2.0",
  "author": "NeuroLift Technologies <info@neuroliftsolutions.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "config",
    "LICENSE",
    "README.md",
    "KNOWN_LIMITATIONS.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NeuroLift-Technologies/rrt-advocate.git",
    "directory": "packages/rrt-advocate"
  },
  "bugs": {
    "url": "https://github.com/NeuroLift-Technologies/rrt-advocate/issues"
  },
  "homepage": "https://github.com/NeuroLift-Technologies/rrt-advocate#readme",
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "optionalDependencies": {
    "vader-sentiment": "^1.1.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
